# CYBERINTEL Platform - System Environment Configurations

# Express Web Server Configuration
PORT=8000

# PostgreSQL Database Connection
# In Docker compose, database hostname matches the container service name "db"
DATABASE_URL=postgresql://postgres:postgres@db:5432/cyberintel?schema=public

# Security Registry Credentials
JWT_SECRET=cyberintel-jwt-secret-key-14c

# Python FastAPI Machine Learning Microservice Connection
ML_SERVICE_URL=http://ml-service:8001
